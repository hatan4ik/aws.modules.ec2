{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDescribeAndLookup",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAccountAttributes", "ec2:DescribeAvailabilityZones", "ec2:DescribeImages",
        "ec2:DescribeInstanceAttribute", "ec2:DescribeInstanceCreditSpecifications", "ec2:DescribeInstanceTypes", "ec2:DescribeInstances",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeLaunchTemplateVersions", "ec2:DescribeLaunchTemplates",
        "ec2:DescribeNetworkAcls", "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables", "ec2:DescribeSecurityGroupRules", "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets", "ec2:DescribeTags", "ec2:DescribeVolumes",
        "ec2:DescribeVpcAttribute", "ec2:DescribeVpcEndpointServices", "ec2:DescribeVpcEndpoints", "ec2:DescribeVpcs",
        "autoscaling:DescribeAutoScalingGroups", "autoscaling:DescribeInstanceRefreshes", "autoscaling:DescribeLifecycleHooks",
        "autoscaling:DescribeLoadBalancerTargetGroups", "autoscaling:DescribeLoadBalancers", "autoscaling:DescribeNotificationConfigurations",
        "autoscaling:DescribePolicies", "autoscaling:DescribeScalingActivities", "autoscaling:DescribeTags",
        "autoscaling:DescribeTrafficSources", "autoscaling:DescribeWarmPool",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TagFixturesAndFleetAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group-rule/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:vpc-endpoint/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:key-pair/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:launch-template/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:volume/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateVpc", "CreateSubnet", "CreateSecurityGroup",
            "AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress",
            "CreateVpcEndpoint", "ImportKeyPair", "CreateLaunchTemplate", "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "CreateTaggedNetworkFixturesKeyPairAndLaunchTemplate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc", "ec2:CreateSubnet", "ec2:CreateSecurityGroup", "ec2:CreateVpcEndpoint",
        "ec2:ImportKeyPair", "ec2:CreateLaunchTemplate"
      ],
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:vpc-endpoint/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:key-pair/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/IntegrationTest": "aws.modules.ec2",
          "aws:RequestTag/Disposable": "true"
        }
      }
    },
    {
      "Sid": "ModifyAndDeleteTaggedFixturesKeyPairAndLaunchTemplate",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute", "ec2:DeleteVpc",
        "ec2:ModifySubnetAttribute", "ec2:DeleteSubnet",
        "ec2:DeleteSecurityGroup", "ec2:ModifySecurityGroupRules",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifyVpcEndpoint", "ec2:DeleteVpcEndpoints",
        "ec2:DeleteKeyPair",
        "ec2:CreateLaunchTemplateVersion", "ec2:ModifyLaunchTemplate",
        "ec2:DeleteLaunchTemplate", "ec2:DeleteLaunchTemplateVersions"
      ],
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:vpc-endpoint/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:key-pair/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/IntegrationTest": "aws.modules.ec2"
        }
      }
    },
    {
      "Sid": "ValidateTheLaunchTemplateInstance",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/IntegrationTest": "aws.modules.ec2",
          "ec2:InstanceType": ["t3.micro", "t3.small", "t4g.micro"],
          "ec2:MetadataHttpTokens": "required"
        },
        "NumericLessThanEquals": {
          "ec2:MetadataHttpPutResponseHopLimit": "1"
        }
      }
    },
    {
      "Sid": "ValidateTheLaunchTemplateVolumes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/IntegrationTest": "aws.modules.ec2"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "100"
        }
      }
    },
    {
      "Sid": "ValidateTheLaunchTemplateNetworkInterface",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/IntegrationTest": "aws.modules.ec2"
        },
        "Bool": {
          "ec2:AssociatePublicIpAddress": "false"
        }
      }
    },
    {
      "Sid": "ValidateTheLaunchTemplateInputs",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:key-pair/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/IntegrationTest": "aws.modules.ec2"
        }
      }
    },
    {
      "Sid": "ValidateTheLaunchTemplateImage",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Owner": "amazon",
          "ec2:ImageType": "machine"
        }
      }
    },
    {
      "Sid": "ResolveTheAmazonLinuxImageParameter",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:*::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "ManageTheGroupUnderTest",
      "Effect": "Allow",
      "Action": [
        "autoscaling:CreateAutoScalingGroup", "autoscaling:UpdateAutoScalingGroup", "autoscaling:DeleteAutoScalingGroup",
        "autoscaling:SetDesiredCapacity", "autoscaling:CreateOrUpdateTags", "autoscaling:DeleteTags"
      ],
      "Resource": "arn:aws:autoscaling:*:<ACCOUNT_ID>:autoScalingGroup:*:autoScalingGroupName/ec2-it-*"
    },
    {
      "Sid": "ReadTheAutoScalingServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/autoscaling.amazonaws.com/AWSServiceRoleForAutoScaling"
    },
    {
      "Sid": "ManageTheInstanceRoleAndProfileUnderTest",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole",
        "iam:TagRole", "iam:UntagRole",
        "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole",
        "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile", "iam:UntagInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/ec2-it/ec2-it-*",
        "arn:aws:iam::<ACCOUNT_ID>:instance-profile/ec2-it/ec2-it-*"
      ]
    },
    {
      "Sid": "AttachOnlyTheSsmManagedPolicy",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/ec2-it/ec2-it-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "PassTheInstanceRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/ec2-it/ec2-it-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "UseTheDisposableVolumeKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey", "kms:Decrypt", "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ListResourceTags"
      ],
      "Resource": "arn:aws:kms:<REGION>:<ACCOUNT_ID>:key/<KEY_ID>",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/IntegrationTest": "aws.modules.ec2"
        }
      }
    },
    {
      "Sid": "GrantTheDisposableVolumeKeyToAwsResources",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:kms:<REGION>:<ACCOUNT_ID>:key/<KEY_ID>",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/IntegrationTest": "aws.modules.ec2"
        },
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    }
  ]
}
